        if (!hasRelevantMutation) return;

        // Debounce fragment detection to avoid excessive calls
        clearTimeout(self._fragmentDetectionTimeout);
        self._fragmentDetectionTimeout = setTimeout(function() {
          self._detectFragments();
          self._maybeRenderPex();
