    /**
     * Detect fragments in the DOM
     */
    _detectFragments: function() {
      const selectors = this._config.fragmentSelectors.split(',');
      const currentFragments = new Set();
      
      selectors.forEach(function(selector) {
        const elements = document.querySelectorAll(selector.trim());
        elements.forEach(function(element) {
          if (element.classList && element.classList.contains('Frags')) {
            const anchors = element.querySelectorAll('a[id^="f"]');
            anchors.forEach(function(anchor) {
              const anchorId = this._extractFragmentId(anchor);
              if (anchorId) {
                currentFragments.add(anchorId);
              }
            }, this);
          }

          // Extract fragment identifier
          const fragmentId = this._extractFragmentId(element);
          if (fragmentId) {
            currentFragments.add(fragmentId);
          }
        }, this);
      }, this);
      
      // Find new fragments
      const newFragments = [];
      currentFragments.forEach(function(fragmentId) {
        if (!this._detectedFragments.has(fragmentId)) {
          newFragments.push(fragmentId);
          this._detectedFragments.add(fragmentId);
        }
      }, this);
      
      // Find removed fragments
      const removedFragments = [];
      this._detectedFragments.forEach(function(fragmentId) {
        if (!currentFragments.has(fragmentId)) {
          removedFragments.push(fragmentId);
          this._detectedFragments.delete(fragmentId);
        }
      }, this);
      
      // Report changes
      if (newFragments.length > 0) {
        this._reportFragmentChanges('detected', newFragments);
      }
      
      if (removedFragments.length > 0) {
        this._reportFragmentChanges('removed', removedFragments);
