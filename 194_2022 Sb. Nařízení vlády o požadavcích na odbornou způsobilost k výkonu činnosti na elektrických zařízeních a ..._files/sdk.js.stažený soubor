    /**
     * Extract fragment identifier from element
     */
    _extractFragmentId: function(element) {
      // Try various methods to extract fragment ID
      
      // Method 1: data-fragment-id attribute
      if (element.dataset.fragmentId) {
        return this._normalizeFragmentKey(element.dataset.fragmentId);
      }
      
      // Method 2: ID attribute with pattern
      if (element.id && element.id.match(/^(frag|par|odst|pism)-/)) {
        return this._normalizeFragmentKey(element.id);
      }

      // Method 2b: Canonical ZPL anchor IDs (laws/treaties)
      // Example: <a id="f4578858"><i id="p2-1"></i></a> or f4581509_odst2
      if (element.id && element.id.match(/^f[a-zA-Z0-9_-]+$/)) {
        return this._normalizeFragmentKey(element.id);
      }

      // Method 2c: Descendant canonical anchor ID
      if (typeof element.querySelector === 'function') {
        const anchor = element.querySelector('a[id^="f"]');
        if (anchor && anchor.id) {
          return this._normalizeFragmentKey(anchor.id);
        }
      }
      
      // Method 3: Class-based detection for specific types
      if (element.classList.contains('Frags')) {
        return null;
      }
      
      // Method 4: For EU law documents
      if (element.classList.contains('eur-body')) {
        const articleMatch = element.textContent.match(/článek\s+(\d+)/i);
        if (articleMatch) {
          return 'article-' + articleMatch[1];
        }
      }
      
      // Method 5: For court decisions
      if (element.classList.contains('jud-legal')) {
        // Use element index as fallback
        const parent = element.parentElement;
        if (parent) {
          const index = Array.from(parent.children).indexOf(element);
          return 'jud-' + index;
        }
      }
      
      return null;
    },
    
    /**
