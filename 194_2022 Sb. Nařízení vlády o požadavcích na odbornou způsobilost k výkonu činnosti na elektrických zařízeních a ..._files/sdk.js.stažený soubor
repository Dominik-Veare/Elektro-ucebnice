    /**
     * Detect the ZPL PEX tab (`.PdMain` containing the native "Praktické
     * příklady" `.ResultList`) and ask the worker iframe to fetch + build the
     * catalogue. Driven off the fragment MutationObserver so it fires when the
     * visitor switches to PEX. `_pexPending` debounces the in-flight request;
     * it resets when the PEX view is gone so re-entry re-renders.
     */
    _maybeRenderPex: function() {
      if (!this._enabled) return;
      // Host-mode suppression (citation assistant / .Frags forbidden classes):
      // never (re)build PEX while suppressed, even if a fragment-observer tick
      // or detection timer fires after the class was added.
      if (this._isHostSuppressed()) return;
      if (!this._isPexContentUrl()) {
        this._pexPending = false;
        this._removePex();
        return;
      }
      var pdMain = document.querySelector('.PdMain');
      var resultList = pdMain ? pdMain.querySelector('.ResultList') : null;
      var alreadyRendered = pdMain ? pdMain.querySelector('[data-linker-pex]') : null;
      if (!pdMain || (!resultList && !alreadyRendered)) {
        this._pexPending = false;
        return;
      }
      if (alreadyRendered) return;
      if (this._pexPending) return;
      this._pexPending = true;
      this._sendMessage('LOAD_PEX', { url: window.location.href });
      // Self-heal: if the iframe never answers (RENDER_PEX / REMOVE_PEX both
      // clear `_pexPending`), release the lock so a later observer tick retries
      // instead of leaving the tab un-transformed for the whole page view.
      var pexSelf = this;
      var pexToken = (this._pexToken = (this._pexToken || 0) + 1);
      setTimeout(function() {
        if (pexSelf._pexPending && pexSelf._pexToken === pexToken) {
          pexSelf._pexPending = false;
        }
      }, 4000);
    },

    /**
     * Receive the pre-rendered catalogue from the iframe and transform
     * `.PdMain` into a tabbed layout: native examples become the "Praktické
     * příklady" tab, the iframe-built post/video/event card lists become the
     * other tabs, and the sponsor strip sits on top.
     */
    _renderPex: function(data) {
      this._pexPending = false;
      if (!data) return;
      // A LOAD_PEX in flight before suppression can answer after the .Frags
      // forbidden class is set -- drop it so PEX stays gone with everything else.
      if (this._isHostSuppressed()) return;
      var pdMain = document.querySelector('.PdMain');
      if (!pdMain || pdMain.querySelector('[data-linker-pex]')) return;

      var resultList = pdMain.querySelector('.ResultList');
      var exampleCount = resultList ? resultList.querySelectorAll('.Item').length : 0;
      var counts = data.counts || {};
      var tabsHtml = data.tabsHtml || {};
      var sponsorsHtml = data.sponsorsHtml || '';

      var dynamicTotal = (counts.posts || 0) + (counts.videos || 0) + (counts.events || 0);
      if (dynamicTotal === 0 && !sponsorsHtml) return; // nothing Linker-supplied

      this._ensurePlacementStyles();
      this._ensurePexStyles();

      var tabsMeta = [];
      if (exampleCount > 0) tabsMeta.push({ key: 'priklady', label: 'Praktické příklady', count: exampleCount, native: true });
      if ((counts.posts || 0) > 0) tabsMeta.push({ key: 'posts', label: 'Příspěvky', count: counts.posts, html: tabsHtml.posts });
      if ((counts.videos || 0) > 0) tabsMeta.push({ key: 'videos', label: 'Videa', count: counts.videos, html: tabsHtml.videos });
      if ((counts.events || 0) > 0) tabsMeta.push({ key: 'events', label: 'Webináře', count: counts.events, html: tabsHtml.events });
      if (tabsMeta.length === 0) return;

      var firstKey = tabsMeta[0].key;
      var buttonsHtml = '';
      var panelsHtml = '';
      for (var i = 0; i < tabsMeta.length; i++) {
        var t = tabsMeta[i];
        var isActive = t.key === firstKey;
        buttonsHtml += '<button type="button" class="linker-pex__tab' + (isActive ? ' is-active' : '') + '" data-linker-pex-tab="' + t.key + '" data-pex-total="' + t.count + '">' + this._pexEscape(t.label) + ' <span class="linker-pex__tab-count">' + t.count + '</span></button>';
        panelsHtml += '<div class="linker-pex__panel' + (isActive ? ' is-active' : '') + '" data-linker-pex-panel="' + t.key + '">' + (t.native ? '' : (t.html || '')) + '</div>';
      }

      var container = document.createElement('div');
      container.className = 'linker-pex';
      container.setAttribute('data-linker-pex', '1');
      if (data.documentId) container.setAttribute('data-linker-pex-document-id', String(data.documentId));
      // Header band: partner logos + expert CTA combined (zakonyprolidiplus
      // brand colours). Headline stands in when there are no partners yet.
      var promoInner = sponsorsHtml || '<div class="linker-pex__promo-headline">Těšíme se na vaše příspěvky!</div>';
      container.innerHTML = '<div class="linker-pex__promo">' + promoInner + this._pexCtaHtml() + '</div>' +
        '<div class="linker-pex__toolbar">' +
          '<div class="linker-pex__tabs" role="tablist">' + buttonsHtml + '</div>' +
          '<div class="linker-pex__search" role="search">' +
            '<span class="linker-pex__search-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="11" cy="11" r="6"></circle><path d="M16 16l4 4"></path></svg></span>' +
            '<input class="linker-pex__search-input" data-linker-pex-search type="text" autocomplete="off" spellcheck="false" placeholder="Hledat v PEX" aria-label="Hledat v PEX">' +
            '<button type="button" class="linker-pex__search-clear" data-linker-pex-search-clear aria-label="Vymazat hledání">&times;</button>' +
          '</div>' +
        '</div>' +
        '<div class="linker-pex__panels">' + panelsHtml + '</div>';

      pdMain.insertBefore(container, pdMain.firstChild);
      this._bindPexSearchHandlers(container);

      // Move native examples into the Příklady panel (preserve native links).
      if (resultList && exampleCount > 0) {
        var prikladyPanel = container.querySelector('[data-linker-pex-panel="priklady"]');
        if (prikladyPanel) prikladyPanel.appendChild(resultList);
      }
      // Hide the now-empty native heading block.
      var gridMain = pdMain.querySelector('.grid-main');
      if (gridMain && !gridMain.querySelector('.ResultList')) {
        gridMain.style.display = 'none';
        gridMain.setAttribute('data-linker-pex-hidden', '1');
      }

      this._handlePexSearch(container, '');
    },

    /** Tear down injected PEX UI, restoring native examples to their place. */
    _removePex: function() {
      this._pexPending = false;
      var container = document.querySelector('.linker-pex[data-linker-pex]');
      if (!container) return;
      var pdMain = (container.closest && container.closest('.PdMain')) || document.querySelector('.PdMain');
      var resultList = container.querySelector('.ResultList');
      var gridMain = pdMain ? pdMain.querySelector('.grid-main[data-linker-pex-hidden]') : null;
      if (gridMain) {
        gridMain.style.display = '';
        gridMain.removeAttribute('data-linker-pex-hidden');
        if (resultList) gridMain.appendChild(resultList);
      } else if (resultList && pdMain) {
        pdMain.appendChild(resultList);
      }
      if (container.parentNode) container.parentNode.removeChild(container);
    },

    _bindPexSearchHandlers: function(container) {
      var search = container ? container.querySelector('.linker-pex__search') : null;
      var input = search ? search.querySelector('[data-linker-pex-search]') : null;
      var clear = search ? search.querySelector('[data-linker-pex-search-clear]') : null;
      if (!search || !input || input._linkerPexSearchBound) return;

      var self = this;
      input._linkerPexSearchBound = true;

      input.addEventListener('input', function(event) {
        event.stopPropagation();
        self._handlePexSearch(container, input.value || '');
      });

      input.addEventListener('keydown', function(event) {
        event.stopPropagation();
        if (event.key !== 'Escape') return;
        input.value = '';
        self._handlePexSearch(container, '');
        event.preventDefault();
      });

      if (clear) {
        clear.addEventListener('click', function(event) {
          event.preventDefault();
          event.stopPropagation();
          input.value = '';
          self._handlePexSearch(container, '');
          input.focus();
        });
      }

      ['pointerdown', 'pointerup', 'mousedown', 'mouseup', 'click', 'dblclick', 'touchstart', 'touchend'].forEach(function(type) {
        search.addEventListener(type, function(event) {
          event.stopPropagation();
        });
      });
    },

    _pexNormalize: function(value) {
      return String(value == null ? '' : value)
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/\s+/g, ' ')
        .trim();
    },

    _pexPanelItems: function(panel) {
      if (!panel || !panel.querySelectorAll) return [];

      return Array.prototype.slice.call(
        panel.querySelectorAll('.ResultList .Item, .linker-placement-card')
      );
    },

    _pexItemSearchText: function(item) {
      if (!item) return '';
      if (typeof item._linkerPexSearchText === 'string') {
        return item._linkerPexSearchText;
      }

      item._linkerPexSearchText = this._pexNormalize(item.textContent || '');
      return item._linkerPexSearchText;
    },

    _ensurePexEmptyState: function(panel) {
      var empty = null;
      var children = panel.children || [];
      for (var i = 0; i < children.length; i++) {
        if (children[i].classList && children[i].classList.contains('linker-pex__empty')) {
          empty = children[i];
          break;
        }
      }
      if (!empty) {
        empty = document.createElement('div');
        empty.className = 'linker-pex__empty';
        empty.textContent = 'Žádné výsledky';
        panel.appendChild(empty);
      }
      return empty;
    },

    _handlePexSearch: function(container, rawQuery) {
      if (!container || !container.querySelectorAll) return;

      var query = this._pexNormalize(rawQuery || '');
      var hasQuery = query.length > 0;
      container.classList.toggle('is-searching', hasQuery);

      var searchWrap = container.querySelector('.linker-pex__search');
      if (searchWrap) {
        searchWrap.classList.toggle('has-query', hasQuery);
      }

      var panels = container.querySelectorAll('[data-linker-pex-panel]');
      var counts = {};
      for (var i = 0; i < panels.length; i++) {
        var panel = panels[i];
        var key = panel.getAttribute('data-linker-pex-panel');
        var items = this._pexPanelItems(panel);
        var visibleCount = 0;

        for (var j = 0; j < items.length; j++) {
          var item = items[j];
          var matches = !hasQuery || this._pexItemSearchText(item).indexOf(query) !== -1;
          item.hidden = !matches;
          if (matches) visibleCount++;
        }

        counts[key] = visibleCount;
        var empty = this._ensurePexEmptyState(panel);
        empty.style.display = hasQuery && visibleCount === 0 ? 'block' : 'none';
      }

      var tabs = container.querySelectorAll('[data-linker-pex-tab]');
      for (var k = 0; k < tabs.length; k++) {
        var tab = tabs[k];
        var tabKey = tab.getAttribute('data-linker-pex-tab');
        var total = parseInt(tab.getAttribute('data-pex-total') || '0', 10) || 0;
        var count = hasQuery ? (counts[tabKey] || 0) : total;
        var badge = tab.querySelector('.linker-pex__tab-count');
        if (badge) badge.textContent = String(count);
      }
    },

    _handlePexInput: function(event) {
