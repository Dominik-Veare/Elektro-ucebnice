	      }

      if (!keywordData.keywords || keywordData.keywords.length === 0) {
        // Still set up click handlers for existing marked keywords
        this._ensureKeywordClickHandler();
        return;
      }
      
      if (this._config.debug) {
        console.log('[LinkerSDK] Marking keywords:', keywordData.keywords.length);
      }
      
      // Process keywords by match type
      const exactKeywords = [];
      const partialKeywords = [];
      const regexKeywords = [];
      
      keywordData.keywords.forEach(function(keyword) {
        if (keyword.match_type === 'regex') {
          if (!this._isRegexSafe(keyword.text)) {
            console.warn('[LinkerSDK] Unsafe regex pattern rejected:', keyword.text.substring(0, 50));
            return;
          }
          try {
            keyword.regex = new RegExp(keyword.text, 'gi');
            regexKeywords.push(keyword);
          } catch (e) {
            console.warn('[LinkerSDK] Invalid regex:', keyword.text, e.message);
          }
        } else if (keyword.match_type === 'partial') {
          partialKeywords.push(keyword);
        } else {
          exactKeywords.push(keyword);
        }
      }, this);
      
      // Find eligible text nodes
      const textNodes = this._getTextNodes(document.body);
      const occurrenceStates = this._prepareOccurrenceStates(textNodes, exactKeywords, partialKeywords, regexKeywords);
      
      // Process each text node
      textNodes.forEach(function(node) {
        this._processTextNode(node, exactKeywords, partialKeywords, regexKeywords, keywordData.fragmentId, occurrenceStates);
      }, this);
      
      // Set up click handlers
      this._ensureKeywordClickHandler();
	  this._observeKeywordOpportunities();
      
      // Emit event
      this._emitEvent('linker:keywords:marked', { count: keywordData.keywords.length });
    },

    _markFragmentContainer: function(container, fragmentId) {
      if (!container || !fragmentId) return;

