	      // any DOM teardown so deterministic cleanup beats node detachment.
	      this._destroyAllCarousels();
	      if (this._carouselVisibilityHandler) {
	        document.removeEventListener('visibilitychange', this._carouselVisibilityHandler);
	        this._carouselVisibilityHandler = null;
	      }
	      this._carouselState = null;
	      this._carouselDocumentHidden = false;
	      this._destroyHoverPreviewRuntime();
	      this._teardownKeywordOpportunityObserver(true);

	      if (this._hostSuppressionObserver) {
	        this._hostSuppressionObserver.disconnect();
	        this._hostSuppressionObserver = null;
	      }

	      // Remove message handler
	      if (this._boundMessageHandler) {
	        window.removeEventListener('message', this._boundMessageHandler);
	        this._boundMessageHandler = null;
	      }

	      // Remove keyword click handler
	      if (this._keywordClickHandler) {
	        document.removeEventListener('click', this._keywordClickHandler);
	        this._keywordClickHandler = null;
	      }

	      if (this._placementClickHandler) {
	        document.removeEventListener('click', this._placementClickHandler);
	        this._placementClickHandler = null;
	      }

	      if (this._pexInputHandler) {
	        document.removeEventListener('input', this._pexInputHandler);
	        this._pexInputHandler = null;
	      }

	      if (this._pexKeydownHandler) {
	        document.removeEventListener('keydown', this._pexKeydownHandler);
	        this._pexKeydownHandler = null;
	      }

	      if (this._iframe) {
	        this._iframe.remove();
	        this._iframe = null;
      }

      this._ready = false;
      this._initSent = false;
      this._enabled = true;
      this._overlayVisible = false;
      this._messageQueue = [];
      this._messageHandlers.clear();
      this._requestCallbacks.clear();
      this._detectedFragments.clear();
	  this._pageViewId = null;

      window.LinkerSDK = null;
    }
  };
})();
