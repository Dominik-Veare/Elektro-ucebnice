      state.seen += 1;
      const index = state.seen;
      const rule = state.rule || { mode: 'all' };

      if (rule.mode === 'first') return index === 1;
      if (rule.mode === 'last') return index === state.total;
      if (rule.mode === 'specific') return (rule.specificIndices || []).indexOf(index) !== -1;
      if (rule.mode === 'tag') return elementTagName && elementTagName.toLowerCase() === rule.tagName;

