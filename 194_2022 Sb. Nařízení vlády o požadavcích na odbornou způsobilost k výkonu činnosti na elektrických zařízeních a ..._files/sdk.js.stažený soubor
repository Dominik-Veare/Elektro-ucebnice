      inner.style.borderRadius = '';
      inner.style.boxDecorationBreak = '';
      inner.style.webkitBoxDecorationBreak = '';
      inner.style.textDecoration = '';
      inner.style.textDecorationLine = '';
      inner.style.textDecorationStyle = '';
      inner.style.textDecorationColor = '';
      inner.style.textDecorationThickness = '';
      inner.style.textUnderlineOffset = '';
      inner.style.cursor = '';
    },

