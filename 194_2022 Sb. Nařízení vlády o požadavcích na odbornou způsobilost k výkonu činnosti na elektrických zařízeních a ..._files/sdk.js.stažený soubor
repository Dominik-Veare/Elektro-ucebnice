/**
 * Linker Worker SDK Loader
 * Version: 1.0.0
 * 
 * This lightweight script loads the React-based Worker SDK
 * and establishes communication between the host page and the worker iframe.
 */
(function() {
  'use strict';
  
  // Prevent multiple initializations
  if (window.LinkerSDK) {
    console.warn('LinkerSDK is already initialized');
    return;
  }
  
  // SDK configuration
  const SDK_VERSION = '1.0.0';
  const WORKER_URL = 'https://worker.linker.webwire.cz';
  const PRODUCTION_API_BASE_URL = 'https://services.zakonyprolidi.cz';
  const DEVELOPMENT_API_BASE_URL = 'https://webwire.cz';
  const PRODUCTION_WS_ENDPOINT = 'wss://services.zakonyprolidi.cz/socket/linker/worker';
  const DEVELOPMENT_WS_ENDPOINT = 'wss://webwire.cz/socket/linker/worker';
  const WORKER_API_OVERRIDE_KEY = 'linker_worker_api_base_url';
  const WORKER_WS_OVERRIDE_KEY = 'linker_worker_ws_endpoint';
  const IFRAME_ID = 'linker-worker-iframe';
  const MESSAGE_NAMESPACE = 'LINKER_';
  
  // SDK implementation
	  window.LinkerSDK = {
	    version: SDK_VERSION,
	    _config: null,
	    _iframe: null,
	    _ready: false,
	    _initSent: false,
	    _enabled: true,
	    _overlayVisible: false,
	    _messageQueue: [],
	    _messageHandlers: new Map(),
	    _boundMessageHandler: null,
	    _requestCallbacks: new Map(),
	    _requestCounter: 0,
	    _keywordClickHandler: null,
	    _keywordOpportunityObserver: null,
	    _keywordOpportunityTimers: null,
	    _keywordOpportunityState: null,
	    _keywordOpportunitySeenPosts: null,
	    _keywordOpportunityVisibilityHandler: null,
	    _pageViewId: null,
	    _placementClickHandler: null,
	    _pexInputHandler: null,
	    _pexKeydownHandler: null,
	    _lastContentMap: null,
	    _lastWildcardPayload: null,
	    _placementInjectionPayloads: [],
	    _hostSuppressionObserver: null,
	    _hostSuppressed: false,
	    _fragmentObserver: null,
	    _detectedFragments: new Set(),
    _fragmentCheckInterval: null,
    // Per-carousel autoplay state. Map<HTMLElement, {timerId, paused, listeners, ro, imgListeners}>.
    // Map (not WeakMap) so teardown can iterate during _destroyAllCarousels.
    _carouselState: null,
    // SINGLE document-level visibilitychange listener — tracks whether the
    // tab is hidden so per-carousel ticks can no-op without each registering
    // their own listener.
    _carouselVisibilityHandler: null,
    _carouselDocumentHidden: false,
    // ADR-card-hover-preview-loop Phase A2 — vanilla hover-preview runtime
    // for placement cards. Single set of delegated listeners on document,
    // single active-preview token, lazy <video> creation only at hover time.
    // null until _setupHoverPreviewRuntime() runs the first time.
    _hoverPreviewState: null,

    _normalizeFragmentSelectors: function(selectors) {
      const defaults = ['a[id^="f"]', '.Frags', '.mark-container', '.jud-ctn', '.eur-body', '.jud-legal'];
      const parts = String(selectors || '')
        .split(',')
        .map(function(selector) { return selector.trim(); })
        .filter(Boolean);
      const seen = new Set();
      const normalized = [];

      parts.concat(defaults).forEach(function(selector) {
        if (seen.has(selector)) return;
        seen.add(selector);
        normalized.push(selector);
      });

      return normalized.join(',');
    },

    /**
     * Initialize the SDK
     * @param {Object} config - Configuration options
     */
    init: function(config) {
	  this._pageViewId = this._createPageViewId();
	  this._keywordOpportunityTimers = new Map();
	  this._keywordOpportunityState = new Map();
	  this._keywordOpportunitySeenPosts = new Set();
      this._config = Object.assign({
        environment: 'production',
        websocket: true,
        ads: false,
        notifications: true,
        wildcardKeywords: true,
        lazy: false,
        debounce: 300,
        batchSize: 50,
        debug: false,
        logLevel: 'error',
        fragmentSelectors: 'a[id^="f"],.Frags,.mark-container',
        fragmentCheckInterval: 1000,
        onReady: null,
        onError: null,
        onFragmentDetected: null,
        onFragmentRemoved: null
      }, config || {});
      this._config.fragmentSelectors = this._normalizeFragmentSelectors(this._config.fragmentSelectors);
      
      if (this._config.debug) {
        console.log('[LinkerSDK] Initializing with config:', this._config);
      }

      // Setup message handler early (before iframe loads)
      this._setupMessageHandler();
      this._setupPlacementClickHandler();
      this._setupCarouselVisibility();
      this._setupHoverPreviewRuntime();
      this._setupHostSuppressionObserver();
      
      // Create iframe immediately or wait for interaction
      if (this._config.lazy) {
        this._setupLazyLoading();
      } else {
        this._createIframe();
      }
      
      // Emit custom event
      this._emitEvent('linker:init', { config: this._config });
    },

	_createPageViewId: function() {
	  try {
	    var bytes = new Uint8Array(16);
	    window.crypto.getRandomValues(bytes);
	    return Array.prototype.map.call(bytes, function(value) {
	      return value.toString(16).padStart(2, '0');
	    }).join('');
	  } catch (e) {
	    // Dedupe identity only, never an authentication secret. Older browsers
	    // still receive a page-local random id rather than losing measurement.
	    var value = '';
	    for (var i = 0; i < 32; i++) value += Math.floor(Math.random() * 16).toString(16);
	    return value;
	  }
	},
    
    /**
     * Create and append the worker iframe
     */
    _createIframe: function() {
      // Check if iframe already exists
      if (document.getElementById(IFRAME_ID)) {
        return;
      }
      
      // Create iframe
      this._iframe = document.createElement('iframe');
      this._iframe.id = IFRAME_ID;
      this._iframe.src = WORKER_URL;
      this._iframe.style.display = 'none';
      this._iframe.style.position = 'fixed';
      this._iframe.style.top = '0';
      this._iframe.style.left = '0';
      this._iframe.style.width = '0';
      this._iframe.style.height = '0';
      this._iframe.style.zIndex = '2147483647';
      this._iframe.style.pointerEvents = 'none';
      this._iframe.style.background = 'transparent';
      this._iframe.style.border = 'none';
      this._iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin');
      // Permissions-Policy delegation: the worker is a cross-origin iframe, so
      // the Fullscreen / Picture-in-Picture / autoplay APIs are blocked inside
      // it unless the host explicitly grants them via the `allow` attribute.
      // Without this, the video player's fullscreen button does nothing.
      this._iframe.setAttribute('allow', 'fullscreen; picture-in-picture; autoplay');

      // Add load handler
      this._iframe.onload = this._onIframeLoad.bind(this);
      this._iframe.onerror = this._onIframeError.bind(this);
      
      // Append to body
      document.body.appendChild(this._iframe);
    },
    
    /**
     * Setup lazy loading - only create iframe on first interaction
     */
    _setupLazyLoading: function() {
      var self = this;
      var triggered = false;
      var events = ['scroll', 'pointerdown', 'pointermove', 'touchstart', 'wheel', 'keydown', 'click'];
      var opts = { passive: true, capture: true };

      var cleanup = function() {
        for (var i = 0; i < events.length; i++) {
          window.removeEventListener(events[i], trigger, opts);
        }
        if (self._lazyObserver) { self._lazyObserver.disconnect(); self._lazyObserver = null; }
        if (self._lazyTimer) { clearTimeout(self._lazyTimer); self._lazyTimer = null; }
        self._lazyCleanup = null;
      };
      self._lazyCleanup = cleanup;

      var trigger = function() {
        if (triggered) return;
        triggered = true;
        cleanup();
        if (!self._enabled) return;
        self._createIframe();
      };

      // Primary trigger: the first real user interaction with the page.
      // (The old implementation only fired on a click on a [data-linker-*]
      // element -- which the iframe itself creates -- so lazy mode could never
      // bootstrap: no iframe -> no highlights -> nothing to click -> no iframe.)
      for (var i = 0; i < events.length; i++) {
        window.addEventListener(events[i], trigger, opts);
      }

      // Secondary trigger: the fragment container scrolls into view.
      if ('IntersectionObserver' in window) {
        try {
          self._lazyObserver = new IntersectionObserver(function(entries) {
            for (var j = 0; j < entries.length; j++) {
              if (entries[j].isIntersecting) { trigger(); return; }
            }
          }, { rootMargin: '300px' });
          var selectors = String(self._config.fragmentSelectors || '').split(',');
          var observed = false;
          for (var s = 0; s < selectors.length; s++) {
            var sel = selectors[s].trim();
            if (!sel) continue;
            var nodes = document.querySelectorAll(sel);
            for (var n = 0; n < nodes.length; n++) { self._lazyObserver.observe(nodes[n]); observed = true; }
          }
          if (!observed && self._lazyObserver) { self._lazyObserver.disconnect(); self._lazyObserver = null; }
        } catch (e) {
          self._lazyObserver = null;
        }
      }

      // Idle fallback: never leave the linker unloaded on a page the visitor
      // just reads without interacting.
      self._lazyTimer = setTimeout(trigger, 3000);
    },
    
	    /**
	     * Setup message handler for cross-frame communication
	     */
	    _setupMessageHandler: function() {
	      if (this._boundMessageHandler) return;
	      this._boundMessageHandler = this._handleMessage.bind(this);
	      window.addEventListener('message', this._boundMessageHandler);
	    },

	    /**
	     * Placement cards live in the host DOM, not inside the iframe. Use one
	     * delegated listener so linker_post cards can open the PostOverlay AND
	     * carousel nav buttons can step the track — both without inline
	     * onclick handlers (CSP-safe). The single document listener fans out
	     * to per-feature methods so each handler stays focused.
	     */
	    _setupPlacementClickHandler: function() {
	      var self = this;
	      if (!this._placementClickHandler) {
	        this._placementClickHandler = function(event) {
	          self._handlePlacementClick(event);
	          self._handleCarouselNavClick(event);
	          self._handlePexClick(event);
	        };
	        document.addEventListener('click', this._placementClickHandler);
	      }
	      if (!this._pexInputHandler) {
	        this._pexInputHandler = function(event) {
	          self._handlePexInput(event);
	        };
	        document.addEventListener('input', this._pexInputHandler);
	      }
	      if (!this._pexKeydownHandler) {
	        this._pexKeydownHandler = function(event) {
	          self._handlePexKeydown(event);
	        };
	        document.addEventListener('keydown', this._pexKeydownHandler);
	      }
	    },

		    /**
		     * Resolve optional API/WS debug overrides from the host page.
		     * Query params persist in localStorage so a debug session survives reloads:
		     * ?linker_worker_api=dev|prod|reset or explicit *_api_url / *_ws_url.
		     */
		    _normalizeEndpoint: function(value, protocol) {
		      if (typeof value !== 'string') return null;
		      var trimmed = value.trim().replace(/\/+$/, '');
		      if (!trimmed) return null;
		      if (protocol === 'http' && trimmed.endsWith('/api/v1/linker/worker')) {
		        trimmed = trimmed.slice(0, -'/api/v1/linker/worker'.length);
		      }
		      try {
		        var parsed = new URL(trimmed);
		        if (protocol === 'http' && parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return null;
		        if (protocol === 'ws' && parsed.protocol !== 'ws:' && parsed.protocol !== 'wss:') return null;
		        return parsed.toString().replace(/\/+$/, '');
		      } catch (e) {
		        return null;
		      }
		    },

		    _getStoredEndpoint: function(key, protocol) {
		      try {
		        return this._normalizeEndpoint(window.localStorage.getItem(key), protocol);
		      } catch (e) {
		        return null;
		      }
		    },

		    _setStoredEndpoint: function(key, value) {
		      try {
		        window.localStorage.setItem(key, value);
		      } catch (e) {
		        // Storage may be disabled by the host page/browser.
		      }
		    },

		    _clearStoredEndpoint: function(key) {
		      try {
		        window.localStorage.removeItem(key);
		      } catch (e) {
		        // Storage may be disabled by the host page/browser.
		      }
		    },

		    _resolveWorkerEndpointOverrides: function() {
		      var params = new URLSearchParams(window.location.search);
		      var mode = String(params.get('linker_worker_api') || params.get('linker_api') || '').trim().toLowerCase();
		      var apiExplicit = this._normalizeEndpoint(params.get('linker_worker_api_url') || params.get('linker_api_url'), 'http');
		      var wsExplicit = this._normalizeEndpoint(params.get('linker_worker_ws_url') || params.get('linker_ws_url'), 'ws');
		      var apiBaseUrl = null;
		      var wsEndpoint = null;

		      if (apiExplicit) {
		        apiBaseUrl = apiExplicit;
		        this._setStoredEndpoint(WORKER_API_OVERRIDE_KEY, apiBaseUrl);
		      }
		      if (wsExplicit) {
		        wsEndpoint = wsExplicit;
		        this._setStoredEndpoint(WORKER_WS_OVERRIDE_KEY, wsEndpoint);
		      }

		      if (!apiBaseUrl || !wsEndpoint) {
		        if (['dev', 'development', 'webwire'].indexOf(mode) !== -1) {
		          apiBaseUrl = apiBaseUrl || DEVELOPMENT_API_BASE_URL;
		          wsEndpoint = wsEndpoint || DEVELOPMENT_WS_ENDPOINT;
		          this._setStoredEndpoint(WORKER_API_OVERRIDE_KEY, apiBaseUrl);
		          this._setStoredEndpoint(WORKER_WS_OVERRIDE_KEY, wsEndpoint);
		        } else if (['prod', 'production', 'services'].indexOf(mode) !== -1) {
		          apiBaseUrl = apiBaseUrl || PRODUCTION_API_BASE_URL;
		          wsEndpoint = wsEndpoint || PRODUCTION_WS_ENDPOINT;
		          this._setStoredEndpoint(WORKER_API_OVERRIDE_KEY, apiBaseUrl);
		          this._setStoredEndpoint(WORKER_WS_OVERRIDE_KEY, wsEndpoint);
		        } else if (['default', 'reset', 'clear'].indexOf(mode) !== -1) {
		          this._clearStoredEndpoint(WORKER_API_OVERRIDE_KEY);
		          this._clearStoredEndpoint(WORKER_WS_OVERRIDE_KEY);
		        } else {
		          apiBaseUrl = apiBaseUrl || this._getStoredEndpoint(WORKER_API_OVERRIDE_KEY, 'http');
		          wsEndpoint = wsEndpoint || this._getStoredEndpoint(WORKER_WS_OVERRIDE_KEY, 'ws');
		        }
		      }

		      return {
		        apiBaseUrl: apiBaseUrl,
		        wsEndpoint: wsEndpoint
		      };
		    },

		    /**
		     * Create a structured-clone safe INIT payload for the worker iframe.
		     * (Functions inside config would break postMessage with DataCloneError.)
		     */
		    _getWorkerInitPayload: function() {
	      let safeConfig = {};
	      try {
	        safeConfig = JSON.parse(JSON.stringify(this._config || {}, function(key, value) {
	          if (typeof value === 'function') return undefined;
	          return value;
	        }));
	      } catch (e) {
	        // Fallback: shallow copy without functions
	        const cfg = this._config || {};
	        Object.keys(cfg).forEach(function(key) {
	          const val = cfg[key];
	          if (typeof val !== 'function') safeConfig[key] = val;
	        });
	      }

		      safeConfig.pageUrl = this._canonicalizePageUrl(window.location.href);
		      const endpointOverrides = this._resolveWorkerEndpointOverrides();
		      if (endpointOverrides.apiBaseUrl) safeConfig.apiBaseUrl = endpointOverrides.apiBaseUrl;
		      if (endpointOverrides.wsEndpoint) safeConfig.wsEndpoint = endpointOverrides.wsEndpoint;
		      return safeConfig;
		    },
    
    /**
     * Show dialog for keyword/post content
     * @param {Object} options - Dialog options
     */
    showDialog: function(options) {
      if (!this._ready) {
        console.error('[LinkerSDK] SDK not ready. Call init() first.');
        return;
      }

      if (!this._enabled) {
        if (this._config.debug) {
          console.log('[LinkerSDK] SDK is disabled, ignoring showDialog()');
        }
        return;
      }
      
      if (this._config.debug) {
        console.log('[LinkerSDK] Showing dialog:', options);
      }
      
      this._setOverlayVisible({ visible: true, mode: 'fullscreen' });

      // Send message to iframe to show dialog
      this._sendMessage('SHOW_DIALOG', options);
    },
    
    /**
     * Handle messages from worker iframe
     */
    _handleMessage: function(event) {
      // Validate origin
      if (event.origin !== WORKER_URL) {
        return;
      }
      
      const message = event.data;
      if (!message || typeof message !== 'object') {
        return;
      }
      
      if (this._config.debug) {
        console.log('[LinkerSDK] Received message:', message);
      }
      
      // Handle different message types
      const type = message.type;
      if (type && type.startsWith(MESSAGE_NAMESPACE)) {
        const cleanType = type.replace(MESSAGE_NAMESPACE, '');
        
        switch (cleanType) {
          case 'READY':
            this._onReady();
            break;
            
          case 'CONTENT_LOADED':
            this._onContentLoaded(message.payload);
            break;

          case 'OVERLAY':
            this._setOverlayVisible(message.payload);
            break;
            
          case 'CREATE_PORTAL':
            this._createPortal(message.payload);
            break;
            
          case 'INJECT_ELEMENT':
            this._injectElement(message.payload);
            break;

          case 'INJECT_AT_FRAGMENT':
            this._rememberPlacementInjection(message.payload);
            this._injectAtFragment(message.payload);
            break;

          case 'REMOVE_PLACEMENTS':
            this._placementInjectionPayloads = [];
            this._removePlacementContainers();
            break;

          case 'ERROR':
            this._handleError(message.payload);
            break;
            
          case 'OPEN_POST':
            this._handleOpenPost(message.data || message.payload);
            break;

          case 'OPEN_URL':
            this._handleOpenUrl(message.payload);
            break;

          case 'WILDCARD_KEYWORDS':
            this._onWildcardKeywords(message.payload);
            break;

          case 'RENDER_PEX':
            this._renderPex(message.payload);
            break;

          case 'REMOVE_PEX':
            this._removePex();
            break;

          default:
            // Check for request callbacks
            if (message.requestId && this._requestCallbacks.has(message.requestId)) {
              const callback = this._requestCallbacks.get(message.requestId);
              this._requestCallbacks.delete(message.requestId);
              callback(message.payload);
            }
            
            // Check for event handlers
            if (this._messageHandlers.has(cleanType)) {
              this._messageHandlers.get(cleanType).forEach(handler => {
                handler(message.payload);
              });
            }
        }
      }
    },
    
    /**
     * Send message to worker iframe
     */
    _sendMessage: function(type, payload, callback) {
      const message = {
        type: MESSAGE_NAMESPACE + type,
        payload: payload,
        timestamp: Date.now()
      };
      
      // Add request ID if callback provided
      if (callback) {
        message.requestId = ++this._requestCounter;
        this._requestCallbacks.set(message.requestId, callback);
      }
      
      if (this._ready && this._iframe) {
        this._iframe.contentWindow.postMessage(message, WORKER_URL);
      } else {
        this._messageQueue.push(message);
      }
    },
    
    /**
     * Called when iframe loads successfully
     */
	    _onIframeLoad: function() {
	      if (this._config.debug) {
	        console.log('[LinkerSDK] Worker iframe loaded');
	      }

	      // Send INIT as the first message (worker responds with READY once fully initialized).
	      if (!this._initSent && this._iframe && this._iframe.contentWindow) {
	        const initPayload = this._getWorkerInitPayload();
	        const message = {
	          type: MESSAGE_NAMESPACE + 'INIT',
	          payload: initPayload,
	          timestamp: Date.now()
	        };

	        this._iframe.contentWindow.postMessage(message, WORKER_URL);
	        this._initSent = true;
	      }
    },
    
    /**
     * Called when iframe fails to load
     */
    _onIframeError: function(error) {
      console.error('[LinkerSDK] Failed to load worker iframe:', error);
      this._handleError({ type: 'IFRAME_LOAD_ERROR', message: 'Failed to load worker' });
    },
    
    /**
     * Called when worker is ready
     */
    _onReady: function() {
      this._ready = true;
      
      // Process queued messages
      while (this._messageQueue.length > 0) {
        const message = this._messageQueue.shift();
        this._iframe.contentWindow.postMessage(message, WORKER_URL);
      }
      
      // Detect document type and load content
      this._detectAndLoadContent();
      
      // Start fragment monitoring
      this._startFragmentMonitoring();
      this._schedulePexDetection();
      
      // Call ready callback
      if (this._config.onReady) {
        this._config.onReady();
      }
      
      // Emit ready event
      this._emitEvent('linker:ready', { version: SDK_VERSION });
    },
    
    /**
     * Detect document type and request content loading
     */
	    _detectAndLoadContent: function() {
	      const url = this._canonicalizePageUrl(window.location.href);
	      const documentType = this._detectDocumentType(url);

	      // Always ask the worker to load mapping; server-side config detection decides if it's supported.
	      this._sendMessage('LOAD_CONTENT', {
        url: url,
        documentType: documentType,
        environment: this._config.environment
      });
    },
    
    /**
     * Detect document type from URL
     */
	    _detectDocumentType: function(url) {
	      if (url.match(/\/cs\/\d{4}-\d+$/)) return 'sbirka_zakonu';
	      if (url.match(/\/ms\/\d{4}-\d+$/)) return 'mezinarodni_smlouvy';
	      if (url.includes('/pravoeu/dokument')) return 'pravo_eu';
	      if (url.includes('/judikat/')) return 'soudni_rozhodnuti';
	      return null;
	    },

	    _canonicalizePageUrl: function(rawUrl) {
	      try {
	        const parsed = new URL(rawUrl, window.location.href);
	        parsed.protocol = 'https:';
	        parsed.hash = '';
	        if (
	          parsed.hostname.endsWith('zakonyprolidi.cz') &&
	          /^\/(cs|ms|pravoeu|eu|judikat|monitor)(\/|$)/i.test(parsed.pathname)
	        ) {
	          parsed.hostname = 'zakonyprolidi.cz';
	        }
	        const lawMatch = parsed.pathname.match(/^\/(cs|ms)\/([^/]+)(?:\/.*)?$/i);
	        if (lawMatch) {
	          parsed.pathname = '/' + lawMatch[1] + '/' + lawMatch[2];
	        }
	        const judikatMatch = parsed.pathname.match(/^\/judikat\/([^/]+)\/([^/]+)(?:\/.*)?$/i);
	        if (judikatMatch) {
	          parsed.pathname = '/judikat/' + judikatMatch[1] + '/' + judikatMatch[2];
	        }
	        if (/^\/pravoeu\/dokument$/i.test(parsed.pathname)) {
	          const celex = parsed.searchParams.get('celex');
	          const celexValue = celex ? celex.trim() : '';
	          parsed.search = celexValue ? '?celex=' + encodeURIComponent(celexValue) : '';
	        } else {
	          parsed.search = '';
	        }
	        if (parsed.pathname.length > 1 && parsed.pathname.endsWith('/')) {
	          parsed.pathname = parsed.pathname.replace(/\/+$/, '');
	        }
	        return parsed.toString();
	      } catch (e) {
	        return rawUrl;
	      }
	    },

	    _normalizeFragmentKey: function(value) {
	      return String(value || '')
	        .trim()
	        .replace(/^#/, '')
	        .replace(/^virtual:/, '');
	    },

	    _extractIdFromSelector: function(selector) {
	      if (!selector || typeof selector !== 'string') return '';
	      const match = selector.match(/#([^#\s]+)/);
	      return this._normalizeFragmentKey(match ? match[1] : '');
	    },

	    _escapeHtml: function(value) {
	      return String(value || '')
	        .replace(/&/g, '&amp;')
	        .replace(/</g, '&lt;')
	        .replace(/>/g, '&gt;')
	        .replace(/"/g, '&quot;')
	        .replace(/'/g, '&#39;');
	    },

    _isHostSuppressed: function() {
      // Citation assistant / host document modes: when the .Frags container
      // carries any of these classes the host runs its own feature (citace,
      // novelizace diff, comparison, ...) and our injected DOM breaks it -- so
      // suppress every worker enhancement until the class clears. Mirrors the
      // legacy linker fragsState().
      var frags = document.querySelector('.Frags');
      if (!frags) return false;
      var forbidden = ['GOTO', 'BK', 'NOVEL', 'NDPX', 'COMPAR', 'EFFECT', 'AddCm'];
      for (var i = 0; i < forbidden.length; i++) {
        if (frags.classList.contains(forbidden[i])) return true;
      }
      return false;
    },

    _setupHostSuppressionObserver: function() {
      if (typeof MutationObserver === 'undefined') return;

      var self = this;
      var install = function() {
        if (!document.body || self._hostSuppressionObserver) return;

