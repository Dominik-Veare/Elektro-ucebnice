        const candidates = Array.isArray(match.candidates) && match.candidates.length > 0
          ? match.candidates
          : [this._candidateFromMatch(match)];

        span.className = 'linker-keyword';
        span.setAttribute('data-linker-keyword', '');
        span.setAttribute('data-keyword-id', match.keyword.id);
        span.setAttribute('data-keyword-text', match.text);
        const candidateFragment = candidates.find(function(candidate) {
          return candidate && (candidate.fragmentId || candidate.fragment_id || candidate.fragment_hash);
        });
        const spanFragmentId = this._normalizeFragmentKey(
          match.keyword.fragmentId ||
          match.keyword.fragment_id ||
          match.keyword.fragment_hash ||
          (candidateFragment && (candidateFragment.fragmentId || candidateFragment.fragment_id || candidateFragment.fragment_hash)) ||
          fragmentId ||
          ''
