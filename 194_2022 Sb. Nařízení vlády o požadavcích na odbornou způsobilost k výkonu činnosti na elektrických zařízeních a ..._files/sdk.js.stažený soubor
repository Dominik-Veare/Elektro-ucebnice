      if (clearBtn) {
        var searchContainer = clearBtn.closest('.linker-pex');
        var input = searchContainer ? searchContainer.querySelector('[data-linker-pex-search]') : null;
        if (!searchContainer || !input) return;
        event.preventDefault();
        input.value = '';
        this._handlePexSearch(searchContainer, '');
        input.focus();
        return;
      }

      var tabBtn = event.target.closest('[data-linker-pex-tab]');
      if (tabBtn) {
        var tabContainer = tabBtn.closest('.linker-pex');
        if (!tabContainer) return;
