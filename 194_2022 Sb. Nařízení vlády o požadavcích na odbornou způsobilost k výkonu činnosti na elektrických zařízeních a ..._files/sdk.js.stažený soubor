    _removeFragmentAuthorStacks: function() {
      document.querySelectorAll('[data-linker-fragment-authors]').forEach(function(node) {
        if (node.parentNode) {
          node.parentNode.removeChild(node);
        }
      });

      document.querySelectorAll('[data-linker-author-positioned]').forEach(function(host) {
        if (host.getAttribute('data-linker-author-positioned') === '1' && host.style.position === 'relative') {
          host.style.position = '';
        }
        host.removeAttribute('data-linker-author-positioned');
      });
    },

    _authorFromValue: function(author) {
      if (!author || typeof author !== 'object') return null;
      var id = Number(author.id);
      var name = typeof author.name === 'string' ? author.name.trim() : '';
      if (!Number.isFinite(id) || id <= 0 || !name) return null;

      return {
        id: id,
        name: name,
        avatarUrl: typeof author.avatar_url === 'string' && author.avatar_url.trim() !== ''
          ? author.avatar_url.trim()
          : (typeof author.avatarUrl === 'string' ? author.avatarUrl.trim() : '')
      };
    },

    _contentMapPostsById: function() {
      var map = new Map();
      var posts = this._lastContentMap && Array.isArray(this._lastContentMap.posts)
        ? this._lastContentMap.posts
        : [];

      posts.forEach(function(post) {
        if (!post || post.id === undefined || post.id === null) return;
        map.set(String(post.id), post);
      });

      return map;
    },

    _sourceKeyFromCandidate: function(candidate) {
      if (!candidate || typeof candidate !== 'object') return '';
      var postId = candidate.postId != null ? candidate.postId : candidate.post_id;
      if (postId !== null && postId !== undefined && postId !== '') {
        return 'post:' + String(postId);
      }

      var sourceType = candidate.sourceType || candidate.source_type;
      var sourceId = candidate.sourceId != null ? candidate.sourceId : candidate.source_id;
      if (sourceType && sourceId !== null && sourceId !== undefined && sourceId !== '') {
        return String(sourceType) + ':' + String(sourceId);
      }

      var destinationUrl = candidate.destinationUrl || candidate.destination_url;
      return destinationUrl ? 'url:' + destinationUrl : '';
    },

    _candidateDedupeKey: function(candidate) {
      if (!candidate || typeof candidate !== 'object') return '';
      var keywordId = candidate.keywordId != null ? candidate.keywordId : candidate.keyword_id;
      var sourceKey = this._sourceKeyFromCandidate(candidate);
      var source = candidate.source || '';
      var documentId = candidate.documentId != null ? candidate.documentId : (candidate.document_id || '');
      return [keywordId || '', sourceKey || '', source || '', documentId || ''].join(':');
    },

    _fragmentDescriptorKeys: function(fragment) {
      var keys = new Set();
      var add = function(value) {
        var normalized = this._normalizeFragmentKey(value);
        if (normalized) keys.add(normalized);
      }.bind(this);

      if (!fragment || typeof fragment !== 'object') return keys;
      add(fragment.hash);
      add(fragment.dom_id);
      add(fragment.visible_dom_id);
      add(fragment.path);
      add(fragment.visible_path);
      add(this._extractIdFromSelector(fragment.selector));
      add(this._extractIdFromSelector(fragment.visible_selector));
      add(fragment.scope_key);
      add(fragment.fragmentId);
      return keys;
    },

    _fragmentDescriptorHasFragmentLink: function(fragment) {
      if (!fragment || typeof fragment !== 'object') return false;
      if (fragment.has_fragment_link === true || fragment.hasFragmentLink === true) return true;
      if (Object.prototype.hasOwnProperty.call(fragment, 'keyword_id')) {
        return fragment.keyword_id === null || typeof fragment.keyword_id === 'undefined';
      }
      if (Object.prototype.hasOwnProperty.call(fragment, 'keywordId')) {
        return fragment.keywordId === null || typeof fragment.keywordId === 'undefined';
      }
      return false;
    },

    _hostFragmentKeys: function(host) {
      var keys = new Set();
      var add = function(value) {
        var normalized = this._normalizeFragmentKey(value);
        if (normalized) keys.add(normalized);
      }.bind(this);

      if (!host) return keys;
      add(host.getAttribute && host.getAttribute('data-fragment-id'));
      add(host.getAttribute && host.getAttribute('data-linker-fragment-scope'));
      add(host.id);
      add(this._resolveFragmentIdFromElement(host));

      var spans = host.querySelectorAll ? host.querySelectorAll('[data-linker-keyword]') : [];
      Array.prototype.forEach.call(spans, function(span) {
        add(span.getAttribute('data-fragment-id'));
      });

      return keys;
    },

    _upsertFragmentAuthorItem: function(itemsByKey, candidateUnion, sourceKey, item, candidate) {
      if (!sourceKey) return;

      var existing = itemsByKey.get(sourceKey);
      if (!existing) {
        existing = {
          sourceKey: sourceKey,
          author: item.author || null,
          hasVideo: Boolean(item.hasVideo),
          sponsored: Boolean(item.sponsored),
          priority: Number(item.priority || 0),
          sourceType: item.sourceType || '',
          sourceId: item.sourceId || null,
          postId: item.postId || null
        };
        itemsByKey.set(sourceKey, existing);
      } else {
        if (!existing.author && item.author) existing.author = item.author;
        existing.hasVideo = existing.hasVideo || Boolean(item.hasVideo);
        existing.sponsored = existing.sponsored || Boolean(item.sponsored);
        existing.priority = Math.max(Number(existing.priority || 0), Number(item.priority || 0));
      }

      if (candidate) {
        var key = this._candidateDedupeKey(candidate);
        if (key) {
          candidateUnion.set(key, candidate);
        }
      }
    },

    _collectFragmentAuthorSources: function(host) {
      var hostKeys = this._hostFragmentKeys(host);
      var postsById = this._contentMapPostsById();
      var itemsByKey = new Map();
      var candidateUnion = new Map();
      var hasFragmentLink = false;

      postsById.forEach(function(post) {
        var fragments = Array.isArray(post.fragments) ? post.fragments : [];
        var matchesHost = fragments.some(function(fragment) {
          var fragmentKeys = this._fragmentDescriptorKeys(fragment);
          var matched = false;
          fragmentKeys.forEach(function(key) {
            if (hostKeys.has(key)) matched = true;
          });
          if (matched && this._fragmentDescriptorHasFragmentLink(fragment)) {
            hasFragmentLink = true;
          }
          return matched;
        }, this);

        if (!matchesHost) return;

        var author = this._authorFromValue(post.author);
        this._upsertFragmentAuthorItem(itemsByKey, candidateUnion, 'post:' + String(post.id), {
          postId: post.id,
          author: author,
          hasVideo: Boolean(post.has_video || post.hasVideo),
          sponsored: Boolean(post.sponsored),
          priority: Number(post.priority || 0),
          sourceType: 'linker_post',
          sourceId: post.id
        }, null);
      }, this);

      var spans = host.querySelectorAll ? host.querySelectorAll('[data-linker-keyword]') : [];
      Array.prototype.forEach.call(spans, function(span) {
        this._parseKeywordCandidates(span).forEach(function(candidate) {
          var sourceKey = this._sourceKeyFromCandidate(candidate);
          if (!sourceKey) return;

          var post = candidate.postId != null ? postsById.get(String(candidate.postId)) : null;
          var author = this._authorFromValue(candidate.author) || this._authorFromValue(post && post.author);
          var sourceType = candidate.sourceType || candidate.source_type || (candidate.postId ? 'linker_post' : '');
          var sourceId = candidate.sourceId != null ? candidate.sourceId : (candidate.source_id != null ? candidate.source_id : candidate.postId);

          this._upsertFragmentAuthorItem(itemsByKey, candidateUnion, sourceKey, {
            postId: candidate.postId || null,
            author: author,
            hasVideo: Boolean(
              candidate.hasVideo ||
              candidate.has_video ||
              sourceType === 'video' ||
              candidate.redirectType === 'video' ||
              candidate.redirect_type === 'video' ||
              (post && (post.has_video || post.hasVideo))
            ),
            sponsored: Boolean(candidate.sponsored || (post && post.sponsored)),
            priority: Number(candidate.priority != null ? candidate.priority : (post ? post.priority || 0 : 0)),
            sourceType: sourceType,
            sourceId: sourceId || null
          }, candidate);
        }, this);
      }, this);

      var items = Array.from(itemsByKey.values()).sort(function(a, b) {
        if (Boolean(a.sponsored) !== Boolean(b.sponsored)) return a.sponsored ? -1 : 1;
        if (Number(a.priority || 0) !== Number(b.priority || 0)) return Number(b.priority || 0) - Number(a.priority || 0);
        var aAuthor = a.author ? Number(a.author.id || 0) : 0;
        var bAuthor = b.author ? Number(b.author.id || 0) : 0;
        if (aAuthor !== bAuthor) return aAuthor - bAuthor;
        return String(a.sourceKey).localeCompare(String(b.sourceKey));
      });

      var authors = [];
      var seenAuthors = new Set();
      items.forEach(function(item) {
        if (!item.author || seenAuthors.has(String(item.author.id)) || authors.length >= 2) return;
        seenAuthors.add(String(item.author.id));
        authors.push(item.author);
      });

      return {
        items: items,
        authors: authors,
        overflow: Math.max(0, items.length - authors.length),
        hasVideo: items.some(function(item) { return Boolean(item.hasVideo); }),
        hasFragmentLink: hasFragmentLink,
        keywordCandidates: Array.from(candidateUnion.values())
      };
    },

    _primaryFragmentIdForHost: function(host) {
      var direct = this._normalizeFragmentKey(host && host.getAttribute && host.getAttribute('data-fragment-id'));
      if (direct) return direct;

      var scoped = this._normalizeFragmentKey(host && host.getAttribute && host.getAttribute('data-linker-fragment-scope'));
      if (scoped) return scoped;

      var span = host && host.querySelector ? host.querySelector('[data-linker-keyword][data-fragment-id]') : null;
      var spanId = this._normalizeFragmentKey(span && span.getAttribute('data-fragment-id'));
      if (spanId) return spanId;

      return this._normalizeFragmentKey(this._resolveFragmentIdFromElement(host));
    },

    _renderFragmentAuthorStack: function(host, summary) {
      var fragmentId = this._primaryFragmentIdForHost(host);
      if (!fragmentId || !summary || !Array.isArray(summary.items) || summary.items.length === 0) return;
      if (!summary.hasFragmentLink) return;
      if (summary.authors.length === 0 && (summary.hasVideo || summary.items.length <= 1)) return;

      var computed = window.getComputedStyle ? window.getComputedStyle(host) : null;
      if (computed && computed.position === 'static' && !host.style.position) {
        host.style.position = 'relative';
        host.setAttribute('data-linker-author-positioned', '1');
      }

      var textStart = computed ? parseFloat(computed.paddingLeft || '0') : 0;
      if (!Number.isFinite(textStart)) textStart = 0;

      var root = document.createElement('span');
      root.setAttribute('data-linker-fragment-authors', '1');
      root.setAttribute('data-fragment-id', fragmentId);
      root.style.setProperty('--lfa-text-start', textStart + 'px');
      root.dataset.keywordCandidates = JSON.stringify(summary.keywordCandidates || []);

      var button = document.createElement('button');
      button.type = 'button';
      button.className = 'lfa-stack';
      button.setAttribute('aria-label', this._fragmentAuthorAriaLabel(summary));

      if (summary.authors.length > 0) {
        summary.authors.forEach(function(author, index) {
          var wrap = document.createElement('span');
          wrap.className = 'lfa-author-wrap';

          var img = document.createElement('img');
          img.className = 'lfa-avatar';
          img.src = author.avatarUrl || '';
          img.alt = author.name;
          img.title = author.name;
          img.loading = 'lazy';
          wrap.appendChild(img);

          if (summary.hasVideo && index === summary.authors.length - 1) {
            var videoOverlay = document.createElement('span');
            videoOverlay.className = 'lfa-video-overlay';
            videoOverlay.setAttribute('aria-hidden', 'true');
            wrap.appendChild(videoOverlay);
          }

          button.appendChild(wrap);
        });

        if (summary.overflow > 0) {
          var overflow = document.createElement('span');
          overflow.className = 'lfa-overflow';
          overflow.textContent = '+' + String(summary.overflow);
          button.appendChild(overflow);
        }
      } else {
        var count = document.createElement('span');
        count.className = 'lfa-count';
        count.textContent = '+' + String(summary.items.length);
        button.appendChild(count);
      }

      root.appendChild(button);
      host.appendChild(root);
    },

    _fragmentAuthorAriaLabel: function(summary) {
      var count = summary && Array.isArray(summary.items) ? summary.items.length : 0;
      var authors = summary && Array.isArray(summary.authors) ? summary.authors : [];
      if (authors.length === 0) {
        return count + ' linker příspěvků v tomto fragmentu';
      }

      var names = authors.map(function(author) { return author.name; }).join(', ');
      var overflow = Math.max(0, count - authors.length);
      return count + ' linker příspěvků autorů ' + names + (overflow > 0 ? ' a ' + overflow + ' dalších' : '');
    },

    _renderFragmentAuthorStacks: function() {
      this._removeFragmentAuthorStacks();

      if (!this._lastContentMap) return;

      // Per-fragment author avatar "bublinky" master switch. Server is the
      // source of truth via /worker/map data.features.fragment_author_avatars;
      // absent or false => overlay stays off (go-live default). Re-enable by
      // flipping LINKER_WORKER_FRAGMENT_AVATARS_ENABLED -- no SDK rebuild.
      var feat = this._lastContentMap.features;
      if (!feat || feat.fragment_author_avatars !== true) return;

      var hosts = new Set();
      document.querySelectorAll('[data-linker-fragment], [data-linker-fragment-scope]').forEach(function(el) {
        hosts.add(this._closestBlockContainer(el) || el);
      }, this);
      document.querySelectorAll('[data-linker-keyword]').forEach(function(el) {
        var host = this._closestBlockContainer(el);
        if (host) hosts.add(host);
      }, this);

      if (hosts.size === 0) return;

      this._ensureFragmentAuthorStyles();
      hosts.forEach(function(host) {
        var summary = this._collectFragmentAuthorSources(host);
        this._renderFragmentAuthorStack(host, summary);
      }, this);
    },

    /**
     * Ensure the keyword click handler is bound exactly once.
     */
    _ensureKeywordClickHandler: function() {
      this._ensureCopySanitizer();
      if (this._keywordClickHandler) return;
      this._keywordClickHandler = this._handleKeywordClick.bind(this);
      document.addEventListener('click', this._keywordClickHandler);
    },

	/**
	 * Observe genuine top-of-funnel opportunities in the host document.
	 * A trigger counts only after >=50 % is visible for a continuous second.
	 * One page load contributes at most one opportunity per primary post even
	 * when the same post is linked from several words or repeated occurrences.
	 */
	_observeKeywordOpportunities: function() {
	  if (!this._enabled || !('IntersectionObserver' in window)) return;
	  var self = this;
	  if (!this._keywordOpportunityObserver) {
	    this._keywordOpportunityObserver = new IntersectionObserver(function(entries) {
	      entries.forEach(function(entry) {
	        self._keywordOpportunityState.set(entry.target, {
	          isIntersecting: entry.isIntersecting,
	          ratio: entry.intersectionRatio,
	        });

	        var currentTimer = self._keywordOpportunityTimers.get(entry.target);
	        if (!entry.isIntersecting || entry.intersectionRatio < 0.5 || document.visibilityState === 'hidden') {
	          if (currentTimer) window.clearTimeout(currentTimer);
	          self._keywordOpportunityTimers.delete(entry.target);
	          return;
	        }

	        if (currentTimer) return;
	        var timer = window.setTimeout(function() {
	          self._keywordOpportunityTimers.delete(entry.target);
	          var state = self._keywordOpportunityState.get(entry.target);
	          if (!entry.target.isConnected || document.visibilityState === 'hidden') return;
	          if (!state || !state.isIntersecting || state.ratio < 0.5) return;
	          self._sendKeywordOpportunity(entry.target);
	        }, 1000);
	        self._keywordOpportunityTimers.set(entry.target, timer);
	      });
	    }, { threshold: [0, 0.5, 1] });

	    this._keywordOpportunityVisibilityHandler = function() {
	      if (document.visibilityState === 'hidden') {
	        self._keywordOpportunityTimers.forEach(function(timer) { window.clearTimeout(timer); });
	        self._keywordOpportunityTimers.clear();
	        return;
	      }
	      // IntersectionObserver need not emit again when a hidden tab becomes
	      // visible without scrolling. Re-observe unresolved triggers so the
	      // continuous one-second requirement starts afresh.
	      document.querySelectorAll('[data-linker-keyword]').forEach(function(element) {
	        self._keywordOpportunityObserver.unobserve(element);
	        self._keywordOpportunityObserver.observe(element);
	      });
	    };
	    document.addEventListener('visibilitychange', this._keywordOpportunityVisibilityHandler);
	  }

	  document.querySelectorAll('[data-linker-keyword]').forEach(function(element) {
	    self._keywordOpportunityObserver.observe(element);
	  });
	},

	_sendKeywordOpportunity: function(element) {
	  var keywordId = Number.parseInt(String(element.dataset.keywordId || ''), 10);
	  var postId = Number.parseInt(String(element.dataset.postId || ''), 10);
	  var candidates = this._parseKeywordCandidates(element);
	  var firstPostCandidate = null;
	  var matchingPostCandidate = null;
	  for (var i = 0; i < candidates.length; i++) {
	    if (candidates[i] && candidates[i].postId != null && String(candidates[i].postId) !== '') {
	      if (!firstPostCandidate) firstPostCandidate = candidates[i];
	      if (Number.isFinite(postId) && postId > 0 && Number(candidates[i].postId) === postId) {
	        matchingPostCandidate = candidates[i];
	        break;
	      }
	    }
	  }
	  var primary = matchingPostCandidate || firstPostCandidate;

	  if ((!Number.isFinite(postId) || postId <= 0) && primary) {
	    postId = Number.parseInt(String(primary.postId), 10);
	  }
	  if ((!Number.isFinite(keywordId) || keywordId <= 0) && primary) {
	    keywordId = Number.parseInt(String(primary.keywordId || ''), 10);
	  }
	  if (!Number.isFinite(postId) || postId <= 0 || !Number.isFinite(keywordId) || keywordId <= 0) return;
	  if (this._keywordOpportunitySeenPosts.has(postId)) return;

	  var fragmentId = element.dataset.fragmentId || '';
	  if (!fragmentId || fragmentId === 'wildcard') {
	    fragmentId = this._resolveFragmentIdFromElement(element) || '';
	  }
	  var documentId = primary && Number(primary.documentId) > 0
